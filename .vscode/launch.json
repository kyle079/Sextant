{
  "version": "0.2.0",
  "configurations": [
    

    {
      "name": "Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/Sextant.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7060;http://localhost:5241"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Frontend",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: dev",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Backend (Container)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "compose: prod up",
      "processName": "Sextant",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "sextant-sextant-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Frontend (Container)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:18080",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Local)",
      "configurations": ["Backend", "Frontend"],
      "stopAll": true
    },
    {
      "name": "Full Stack (Container)",
      "configurations": ["Backend (Container)", "Frontend (Container)"],
      "postDebugTask": "compose: prod down",
      "stopAll": true
    }
  ]
}
